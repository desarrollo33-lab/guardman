---
// /seguridad-privada — índice de la capa de autoridad.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHORITY_PAGES } from '../../lib/authority';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';

export const prerender = true;
---

<BaseLayout
  title="Seguridad privada en Chile: guías de referencia"
  description="Guías sobre el marco legal y operativo de la seguridad privada en Chile: certificación OS-10, Ley 21.659, facultades de los guardias y funciones en condominios."
  breadcrumb="Seguridad privada"
  breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Seguridad privada', url: '/seguridad-privada' }]}
>
  <section class="idx-hero">
    <div class="container">
      <span class="idx-kicker">Guías de referencia</span>
      <h1>Seguridad privada en Chile</h1>
      <p class="idx-lead">
        Material de referencia sobre el marco legal y operativo del rubro. Cada guía explica un
        punto concreto con la normativa vigente a la vista, para que puedas verificar lo que te
        afirma cualquier proveedor, incluido nosotros.
      </p>
    </div>
  </section>

  <section class="idx-body">
    <div class="container">
      <div class="idx-grid">
        {AUTHORITY_PAGES.map((p) => (
          <a href={`/seguridad-privada/${p.slug}`} class="idx-card">
            <h2>{p.title}</h2>
            <p>{p.metaDescription}</p>
            <span class="idx-link">Leer la guía →</span>
          </a>
        ))}
      </div>

      <div class="idx-note">
        <Icon name="doc" size={20} />
        <div>
          <h2>Sobre la vigencia de esta información</h2>
          <p>
            La Ley 21.659 entró en vigor el 28 de noviembre de 2025 y su última modificación
            corresponde a la Ley 21.825, de mayo de 2026. Las guías se actualizan cuando cambia
            el texto normativo, no de forma periódica. Cada una incluye las fuentes oficiales
            para que puedas verificar los datos directamente.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="idx-cta">
    <div class="container">
      <LeadCTA
        title="GuardMan Chile"
        description="Empresa de seguridad privada autorizada, con 200+ guardias certificados OS-10 y central de monitoreo propia 24/7."
      />
    </div>
  </section>
</BaseLayout>

<style is:global>
  .idx-hero { background: var(--navy, #1a2744); padding: 56px 0 48px; color: #fff; }
  .idx-kicker {
    display: inline-block; font-size: 12px; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7); margin-bottom: 14px;
  }
  .idx-hero h1 {
    font-size: clamp(28px, 4.2vw, 42px); font-weight: 800; line-height: 1.15;
    margin: 0 0 18px; letter-spacing: -0.02em;
  }
  .idx-lead {
    font-size: clamp(16px, 1.7vw, 18px); line-height: 1.65;
    color: rgba(255, 255, 255, 0.85); max-width: 720px; margin: 0;
  }
  .idx-body { padding: 48px 0 32px; }
  .idx-grid {
    display: grid; gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }
  .idx-card {
    border: 1px solid #e2e6ec; border-radius: 12px; padding: 26px;
    background: #fff; text-decoration: none; display: block;
    transition: border-color .15s, transform .15s;
  }
  .idx-card:hover { border-color: #3b82f6; transform: translateY(-2px); }
  .idx-card h2 { font-size: 18px; font-weight: 700; margin: 0 0 10px; color: var(--navy, #1a2744); line-height: 1.4; }
  .idx-card p { font-size: 15px; line-height: 1.65; color: #555; margin: 0 0 14px; }
  .idx-link { font-size: 14px; font-weight: 600; color: #2563eb; }
  .idx-note {
    display: flex; gap: 16px; align-items: flex-start;
    background: #f8f9fb; border-radius: 12px; padding: 26px; margin-top: 40px;
  }
  .idx-note svg { flex-shrink: 0; color: #3b82f6; margin-top: 2px; }
  .idx-note h2 { font-size: 17px; font-weight: 700; margin: 0 0 8px; color: var(--navy, #1a2744); }
  .idx-note p { font-size: 15px; line-height: 1.7; color: #555; margin: 0; }
  .idx-cta { padding: 0 0 64px; }
</style>
