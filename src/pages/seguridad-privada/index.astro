---
// /seguridad-privada — índice de la capa de autoridad.
// Usa PageHero y card-grid; sin CSS propio.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHORITY_PAGES } from '../../lib/authority';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';

export const prerender = true;
---

<BaseLayout
  title="Seguridad privada en Chile: guías de referencia"
  description="Guías sobre el marco legal y operativo de la seguridad privada en Chile: certificación OS-10, Ley 21.659, facultades de los guardias y funciones en condominios."
  breadcrumb="Seguridad privada"
  breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Seguridad privada', url: '/seguridad-privada' }]}
>
  <PageHero
    variant="dark"
    badge="Guías de referencia"
    badgeIcon="doc"
    title="Seguridad privada en Chile"
    subtitle="Material de referencia sobre el marco legal y operativo del rubro. Cada guía explica un punto concreto con la normativa vigente a la vista, para que puedas verificar lo que te afirma cualquier proveedor, incluido nosotros."
  />

  <section class="contenido" data-od-id="contenido">
    <div class="container">
      <div class="card-grid">
        {AUTHORITY_PAGES.map((p) => (
          <a href={`/seguridad-privada/${p.slug}`} class="card">
            <div class="card-body">
              <div class="card-icon">
                <Icon name="doc" size={20} />
              </div>
              <h3>{p.title}</h3>
              <p>{p.metaDescription}</p>
              <span class="card-link">Leer la guía →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section" data-od-id="vigencia">
    <div class="container">
      <div class="detail-issues-grid">
        <div class="detail-issue-card">
          <Icon name="doc" size={18} />
          <span>
            <strong>Sobre la vigencia de esta información.</strong> La Ley 21.659 entró
            en vigor el 28 de noviembre de 2025 y su última modificación corresponde a la
            Ley 21.825, de mayo de 2026. Las guías se actualizan cuando cambia el texto
            normativo, no de forma periódica. Cada una incluye las fuentes oficiales para
            que puedas verificar los datos directamente.
          </span>
        </div>
      </div>
    </div>
  </section>

  <LeadCTA
    variant="inline"
    title="GuardMan Chile"
    subtitle="Empresa de seguridad privada autorizada, con 200+ guardias certificados OS-10 y central de monitoreo propia 24/7."
    trustBadges={true}
  />
</BaseLayout>
