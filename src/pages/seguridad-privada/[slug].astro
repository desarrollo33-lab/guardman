---
// /seguridad-privada/[slug] — Capa de autoridad (Fase 1)
//
// Estas páginas NO venden: explican. Su objetivo es que las IAs y los
// buscadores las citen cuando alguien pregunta sobre el marco legal del
// rubro en Chile.
//
// Estructura: la de /servicios/[slug], la página de detalle canónica.
// Sin CSS propio: todo sale de classes que ya existen en components.css.
// Para tablas se usa `legal-table`, que es el patrón público del sitio
// (el de /privacidad). `data-table` existe pero solo en el panel admin.
//
// Schema: `ScholarlyArticle` con `citation` a las fuentes oficiales, que es
// lo que permite atribuirle la fuente a un asistente. Se declara vía
// `extraSchemas` para no duplicar el Article que emite BaseLayout.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHORITY_PAGES } from '../../lib/authority';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { EDITORIAL_BRIDGE, bridgeItems } from '../../lib/internal-links';

export const prerender = true;

export function getStaticPaths() {
  return AUTHORITY_PAGES.map((p) => ({
    params: { slug: p.slug },
    props: { page: p },
  }));
}

const { page } = Astro.props;

const citationLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: page.h1,
  about: [
    { '@type': 'Thing', name: 'Seguridad privada en Chile' },
    { '@type': 'Legislation', name: 'Ley 21.659 sobre Seguridad Privada' },
    { '@type': 'Thing', name: 'Certificación OS-10' },
  ],
  citation: page.sources.map((s) => ({
    '@type': 'CreativeWork',
    name: s.label,
    url: s.url,
  })),
  inLanguage: 'es-CL',
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  article={{
    headline: page.h1,
    description: page.metaDescription,
    datePublished: page.updatedISO,
    dateModified: page.updatedISO,
  }}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Seguridad privada', url: '/seguridad-privada' },
    { name: page.title, url: `/seguridad-privada/${page.slug}` },
  ]}
  faq={page.faqs.map((f) => ({ question: f.q, answer: f.a }))}
  extraSchemas={[citationLd]}
>
  <section class="detail-hero" data-od-id="hero">
    <div class="container">
      <div class="detail-hero-badge">
        <span class="detail-hero-badge-icon">
          <Icon name="doc" size={14} />
        </span>
        Guía de referencia
      </div>
      <h1>{page.h1}</h1>
      <p>{page.lead}</p>
      <div class="detail-hero-ctas">
        <a href="/cotizacion" class="btn btn-primary">Cotizar para mi propiedad</a>
        <a href="/seguridad-privada" class="btn btn-outline-light">Ver todas las guías</a>
      </div>
    </div>
  </section>

  <section class="contenido" data-od-id="contenido">
    <div class="container">
      <div class="detail-content-grid">
        <div class="article-body">
          {page.sections.map((s) => (
            <div class="block">
              <h2>{s.heading}</h2>
              {s.body.map((p) => <p>{p}</p>)}
            </div>
          ))}

          {page.tables.map((t) => (
            <div class="block">
              <h2>{t.caption}</h2>
              <div class="legal-table-wrap">
                <table class="legal-table">
                  <thead>
                    <tr>{t.columns.map((c) => <th>{c}</th>)}</tr>
                  </thead>
                  <tbody>
                    {t.rows.map((r) => (
                      <tr>{r.map((cell) => <td>{cell}</td>)}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}

          <div class="block" data-od-id="block-faq">
            <h2>Preguntas frecuentes</h2>
            <div class="detail-faq">
              {page.faqs.map((f, i) => (
                <details open={i === 0}>
                  <summary>{f.q}</summary>
                  <div class="answer">{f.a}</div>
                </details>
              ))}
            </div>
          </div>

          <div class="block" data-od-id="block-sources">
            <h2>Fuentes</h2>
            <p>
              Los datos legales de esta página corresponden al texto vigente de la
              normativa citada. Si necesita confirmar un punto específico, la fuente
              primaria es la que manda.
            </p>
            <div class="detail-features-grid">
              {page.sources.map((s) => (
                <div class="detail-feature-item">
                  <Icon name="doc" size={16} />
                  <span>
                    <a href={s.url} rel="nofollow noopener" target="_blank">{s.label}</a>
                  </span>
                </div>
              ))}
            </div>
          </div>

          <RelatedLinks
            items={bridgeItems(EDITORIAL_BRIDGE[page.slug])}
            title="Dónde se aplica esto"
            subtitle="Lo que exige la normativa no es teórico: son puntos concretos del contrato que se compran como servicio."
            odId="block-bridge"
          />
        </div>

        <aside data-od-id="sidebar">
          <div class="sidebar-sticky">
            <div class="sidebar-cta-top">
              <h3>Necesita un proveedor que cumpla esto</h3>
              <p>
                Todos los puntos de esta página son exigibles en un contrato. Si su
                proveedor actual no puede acreditarlos, conviene revisar el contrato.
              </p>
              <a href="/cotizacion" class="btn btn-primary">Cotizar para mi propiedad</a>
              <a href="/contacto" class="btn btn-outline">Enviar mi consulta</a>
            </div>
            <div class="sidebar-body">
              <div class="sb-section">
                <h4>Otras guías de referencia</h4>
                {AUTHORITY_PAGES.filter((p) => p.slug !== page.slug).map((p) => (
                  <a href={`/seguridad-privada/${p.slug}`} class="sb-link">{p.title}</a>
                ))}
              </div>
              <div class="sb-section">
                <h4>Guías de contratación</h4>
                <a href="/guias/cuantos-guardias-necesita-mi-condominio" class="sb-link">Dotación de un condominio</a>
                <a href="/guias/como-elegir-empresa-de-seguridad" class="sb-link">Cómo verificar un proveedor</a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <LeadCTA
    variant="inline"
    title="GuardMan Chile"
    subtitle="Más de 10 años, 200+ guardias certificados OS-10 y central de monitoreo propia 24/7, con cobertura en 16 comunas."
    trustBadges={true}
  />
</BaseLayout>
