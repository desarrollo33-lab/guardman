---
// /admin/login — página de login (sin AdminLayout para evitar auth guard).
import '../../styles/global.css';
import { SITE } from '../../lib/constants';

const redirect = Astro.url.searchParams.get('redirect') ?? '/admin';
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso — GuardMan Admin</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-theme="dark" class="login-body">
    <div class="login-shell">
      <!-- ═══════ Panel de marca (desktop) ═══════ -->
      <aside class="login-brand" aria-hidden="true">
        <div class="brand-grid"></div>
        <div class="brand-glow"></div>
        <div class="brand-inner">
          <div class="brand-mark">
            <img src="/images/logo-icon.png" alt="" class="brand-logo" />
            <span class="brand-name">GuardMan</span>
          </div>
          <h1 class="brand-headline">Centro de Operaciones</h1>
        </div>
      </aside>

      <!-- ═══════ Formulario ═══════ -->
      <main class="login-panel">
        <form id="login-form" class="login-card" novalidate>
          <div class="login-mobile-brand">
            <img src="/images/logo-icon.png" alt="" class="brand-logo" />
            <span>GuardMan</span>
          </div>
          <header class="login-header">
            <h2>Bienvenido</h2>
            <p class="sub">Ingresa tus credenciales para acceder al panel.</p>
          </header>

          <div id="login-error" class="login-error" role="alert" hidden></div>

          <div class="login-field">
            <label for="email">Correo electrónico</label>
            <div class="login-input-wrap">
              <svg class="login-input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M3 7.5A2.5 2.5 0 0 1 5.5 5h13A2.5 2.5 0 0 1 21 7.5v9a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 16.5v-9Z" stroke="currentColor" stroke-width="1.5"/>
                <path d="m4 8 8 5 8-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <input id="email" type="email" name="email" required autocomplete="username" placeholder="tu@correo.cl" />
            </div>
          </div>

          <div class="login-field">
            <label for="password">Contraseña</label>
            <div class="login-input-wrap">
              <svg class="login-input-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="4" y="10" width="16" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
                <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="12" cy="15" r="1.2" fill="currentColor"/>
              </svg>
              <input id="password" type="password" name="password" placeholder="••••••••" required autocomplete="current-password" />
              <button type="button" id="toggle-pass" class="login-pass-toggle" aria-label="Mostrar contraseña" aria-pressed="false">
                <svg class="eye-show" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
                </svg>
                <svg class="eye-hide" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M3 3l18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  <path d="M10.6 6.2A10.7 10.7 0 0 1 12 6c6.5 0 10 6 10 6a17.6 17.6 0 0 1-3.1 3.9M6.6 6.6A17.6 17.6 0 0 0 2 12s3.5 6 10 6c1.5 0 2.9-.3 4.1-.8" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>

          <button type="submit" id="login-btn" class="login-btn">
            <span id="login-btn-text">Iniciar sesión</span>
            <svg class="login-btn-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="login-meta">
            <span class="cert-badge">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.5 9.4 8 11 4.5-1.6 8-6 8-11V5l-8-3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              OS-10 autorizado
            </span>
            <span class="cert-sep">·</span>
            <span class="cert-text">Acceso restringido</span>
          </div>
        </form>
      </main>
    </div>

    <script is:inline define:vars={{ redirect, apiUrl: SITE.API_URL }}>
      // ════════════════════════════════════════════════════════════
      // Client-side rate limit: 5 attempts per minute, sliding window.
      // Persists across sessions; clears on success.
      // ════════════════════════════════════════════════════════════
      const ATTEMPTS_KEY = 'gm_login_attempts';
      const MAX_ATTEMPTS = 5;
      const WINDOW_MS = 60_000;

      const readAttempts = () => {
        try {
          const raw = localStorage.getItem(ATTEMPTS_KEY);
          if (!raw) return [];
          const arr = JSON.parse(raw);
          return Array.isArray(arr) ? arr.filter((t) => Date.now() - t < WINDOW_MS) : [];
        } catch { return []; }
      };
      const writeAttempts = (arr) => {
        try { localStorage.setItem(ATTEMPTS_KEY, JSON.stringify(arr)); } catch {}
      };
      const clearAttempts = () => {
        try { localStorage.removeItem(ATTEMPTS_KEY); } catch {}
      };
      const isLocked = () => readAttempts().length >= MAX_ATTEMPTS;
      const lockSeconds = () => {
        const arr = readAttempts();
        if (!arr.length) return 0;
        const oldest = arr[0];
        const remaining = Math.ceil((WINDOW_MS - (Date.now() - oldest)) / 1000);
        return Math.max(remaining, 1);
      };

      const ACCESS_KEY = 'gm_token';
      const ACCESS_EXP = 'gm_token_expires_at';
      const REFRESH_KEY = 'gm_refresh_token';
      const REFRESH_EXP = 'gm_refresh_expires_at';
      const ACCESS_TTL = 2 * 60 * 60 * 1000;
      const REFRESH_TTL = 30 * 24 * 60 * 60 * 1000;

      const form = document.getElementById('login-form');
      const errBox = document.getElementById('login-error');
      const btn = document.getElementById('login-btn');
      const btnText = document.getElementById('login-btn-text');
      const btnArrow = btn?.querySelector('.login-btn-arrow');

      const showError = (msg) => {
        errBox.hidden = false;
        errBox.textContent = '⚠ ' + msg;
        errBox.classList.remove('shake');
        // restart animation
        void errBox.offsetWidth;
        errBox.classList.add('shake');
      };

      const lockUI = () => {
        btn.disabled = true;
        btnText.textContent = 'Bloqueado — espera ' + lockSeconds() + 's';
        if (btnArrow) btnArrow.style.display = 'none';
      };

      const unlockUI = () => {
        btn.disabled = false;
        btnText.textContent = 'Iniciar sesión';
        if (btnArrow) btnArrow.style.display = '';
      };

      // Password visibility toggle
      const passInput = document.getElementById('password');
      const passToggle = document.getElementById('toggle-pass');
      if (passToggle && passInput) {
        passToggle.addEventListener('click', () => {
          const shown = passInput.type === 'text';
          passInput.type = shown ? 'password' : 'text';
          passToggle.setAttribute('aria-pressed', String(!shown));
          passToggle.setAttribute('aria-label', shown ? 'Mostrar contraseña' : 'Ocultar contraseña');
        });
      }

      // If already locked on load, disable the form
      if (isLocked()) {
        lockUI();
        showError('Demasiados intentos. Espera ' + lockSeconds() + 's antes de reintentar.');
        setInterval(() => {
          if (!isLocked()) {
            unlockUI();
            errBox.hidden = true;
          } else {
            btnText.textContent = 'Bloqueado — espera ' + lockSeconds() + 's';
          }
        }, 1000);
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errBox.hidden = true;

        if (isLocked()) {
          showError('Demasiados intentos. Espera ' + lockSeconds() + 's.');
          return;
        }

        btn.disabled = true;
        btnText.textContent = 'Conectando…';
        if (btnArrow) btnArrow.style.display = 'none';

        try {
          const email = form.email.value;
          const password = form.password.value;
          const res = await fetch(`${apiUrl}/api/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });
          const data = await res.json();
          if (!data.ok) {
            const attempts = readAttempts();
            attempts.push(Date.now());
            writeAttempts(attempts);
            if (isLocked()) { lockUI(); return; }
            throw new Error(data.error || 'Credenciales inválidas');
          }
          const payload = data.data ?? data;
          const access = payload.access_token ?? payload.token;
          const refresh = payload.refresh_token;
          if (!access) throw new Error('Token no recibido del servidor');

          localStorage.setItem(ACCESS_KEY, access);
          localStorage.setItem(ACCESS_EXP, String(Date.now() + ACCESS_TTL));
          if (refresh) {
            localStorage.setItem(REFRESH_KEY, refresh);
            localStorage.setItem(REFRESH_EXP, String(Date.now() + REFRESH_TTL));
          }

          // Set cookie httpOnly server-side via nuestro endpoint, para que el
          // middleware SSR pueda verificar la sesión en rutas /admin/*.
          // Si este fetch falla, el usuario puede seguir usando el panel
          // (login localStorage funciona), pero el SSR no tendrá cookie
          // y la próxima request de página completa redirigirá a login.
          try {
            await fetch('/api/admin/session', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({ token: access, refresh: refresh ?? undefined }),
            });
          } catch {
            // No bloqueamos el flujo. La cookie es una mejora defense-in-depth.
          }

          clearAttempts();
          btnText.textContent = 'Acceso concedido';
          if (btnArrow) btnArrow.style.display = '';
          window.location.href = redirect;
        } catch (err) {
          showError(err.message);
          btn.disabled = isLocked();
          if (isLocked()) {
            lockUI();
          } else {
            unlockUI();
          }
        }
      });

      // Si ya hay token válido, asegúrate de que la cookie httpOnly esté seteada
      // y redirige. Si la cookie no existe aún, fire-and-forget el endpoint.
      const existing = localStorage.getItem(ACCESS_KEY);
      const exp = Number(localStorage.getItem(ACCESS_EXP) ?? 0);
      if (existing && existing !== 'undefined' && exp > Date.now()) {
        fetch('/api/admin/session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ token: existing }),
        })
          .catch(() => {})
          .finally(() => {
            window.location.href = redirect;
          });
      }
    </script>
  </body>
</html>
