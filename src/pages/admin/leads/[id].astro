---
// /admin/leads/[id] — Lead 360°.
// SSR solo monta el shell; el componente React carga el lead desde /api/leads/[id].
// No usamos crmLeads (mock) aquí: el lead se carga client-side desde D1.
import AdminLayout from '../../../layouts/AdminLayout.astro';
import LeadDetail from '../../../islands/crm/LeadDetail.tsx';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/admin/leads');
}
---

<AdminLayout
  title="Detalle del lead"
  section="leads"
  breadcrumb={[{ name: 'Leads', url: '/admin/leads' }, { name: 'Detalle' }]}
>
  <LeadDetail client:only="react" leadId={id} />
</AdminLayout>
