---
// /servicios/[service]/[location] — combo SEO pages (migración 1:1 del live).
// Genera 9 servicios × 14 ubicaciones = 126 páginas estáticas.
// Estructura idéntica al live: hero + contenido (con blocks) + block-related.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SERVICE_NAMES, LOCATIONS, SITE, ZONE_CONTEXT } from '../../../lib/constants';
import { SERVICES, LOCATIONS as LOC_CONTENT } from '../../../lib/content';
import { SERVICE_ICONS } from '../../../lib/icons';
import Icon from '../../../components/Icon.astro';
import StaffSection from '../../../components/StaffSection.astro';
import RelatedLinks from '../../../components/RelatedLinks.astro';
import { SERVICE_BRIDGE, bridgeItems } from '../../../lib/internal-links';

export const prerender = true;

export async function getStaticPaths() {
  const paths = [];
  for (const svcSlug of Object.keys(SERVICES)) {
    for (const loc of LOCATIONS) {
      paths.push({
        params: { service: svcSlug, location: loc.slug },
        props: { serviceSlug: svcSlug, locationSlug: loc.slug },
      });
    }
  }
  return paths;
}

interface Props {
  serviceSlug: string;
  locationSlug: string;
}
const { serviceSlug, locationSlug } = Astro.props;
const svc = SERVICES[serviceSlug];
const loc = LOC_CONTENT[locationSlug];
// Location desde constants (para schema)
const locSchema = LOCATIONS.find((l) => l.slug === locationSlug);

// Intro del combo: servicio + contexto real de la comuna.
//
// ANTES: textos con claims falsos y verificablemente incorrectos, idénticos en
// las 14 comunas con solo el nombre cambiado. Ejemplos publicados que se
// eliminaron en 2026-10-02:
//   - Lampa descrita como una de las comunas mas exclusivas de Santiago (Lampa es rural
//     y periférica, al norte)
//   - una de las comunas con mayor inversion en seguridad en todo Chile, con
//     mas de 850 camaras municipales (sin fuente)
//   - en un contexto de creciente delincuencia en la RM (claim estadistico
//     sin fuente)
// Ahora cada comuna se describe con ZONE_CONTEXT, que es la descripción real
// verificada en constants.ts, y los claims se limitan a lo que GuardMan puede
// sostener: cobertura y certificación.
const zona = ZONE_CONTEXT[locationSlug] ?? `comuna de la zona ${loc.zone}`;

const comboIntro: Record<string, string> = {
  'guardias-de-seguridad': `GuardMan Chile presta servicios de guardias de seguridad en ${loc.name}, ${zona}. El equipo está compuesto por personal certificado OS-10, con cobertura los 7 días de la semana y supervisión desde nuestra central de monitoreo. Cada sitio se dimensiona según el riesgo real de la propiedad, no con una dotación genérica.`,
  'cctv-videovigilancia': `Instalamos y operamos sistemas de videovigilancia en ${loc.name}, ${zona}. La cobertura municipal y la seguridad privada son complementarias: nosotros complementamos la seguridad pública con vigilancia sobre los activos que nos contratan. Diseñamos el sistema según la superficie a cubrir, los puntos de acceso y el nivel de riesgo del sitio.`,
  'control-de-accesos': `En ${loc.name}, ${zona}, implementamos control de accesos con tecnología y personal certificado OS-10. El diseño del sistema se hace sobre el flujo real de la propiedad: cantidad de accesos, horarios, tipo de visitantes y registro de cada ingreso.`,
  'escoltas-privados': `Nuestro servicio de PPI (Protección de Personas Importantes) cubre ${loc.name}, ${zona}. Trabajamos con equipos certificados OS-10, evaluación previa de riesgos y coordinación con los organismos de seguridad competentes.`,
  'monitoreo-24-7': `Operamos una central de monitoreo propia que supervisa los sitios de ${loc.name}, ${zona} las 24 horas, los 365 días. Cada alerta se valida antes de escalar: el punto es reducir falsos positivos, no generar más notificaciones.`,
  'seguridad-eventos': `Planificamos seguridad para eventos en ${loc.name}, ${zona}. El servicio incluye control de accesos, cobertura de puntos críticos y coordinación con Carabineros cuando el nivel de riesgo lo requiere.`,
  'seguridad-deportiva': `Cubrimos eventos y competencias en ${loc.name}, ${zona}, con control de accesos por tribuna, cobertura perimetral y enlace con Carabineros. El personal asignado es certificado OS-10.`,
  'seguridad-industrial': `La seguridad industrial en ${loc.name}, ${zona}, combina cumplimiento legal con protección de activos y continuidad operativa. Evaluamos el sitio y definimos los puestos de guardia necesarios según el riesgo real.`,
  'auditoria-seguridad': `Realizamos auditorías de seguridad en ${loc.name}, ${zona}. Evaluamos los controles existentes, identificamos brechas y entregamos un plan priorizado por nivel de riesgo y costo de implementación.`,
  'guard-pod': `Guardpod es un sistema autónomo que opera sin conexión eléctrica ni a internet. Es la alternativa en ${loc.name}, ${zona}, para faenas, terrenos y recintos temporales donde no hay infraestructura de vigilancia disponible.`,
  'aseo': `Prestamos servicio de aseo profesional en ${loc.name}, ${zona}. El trabajo se realiza con personal propio uniformado, productos certificados y un supervisor de terreno asignado a cada cuenta.`,
};

// El intro de aseo queda fuera de comboIntro arriba solo por orden histórico;
// se resuelve aquí para no duplicar la entrada.
const intro = comboIntro[serviceSlug] ?? svc.longDesc;

// ─── FASE 2: mapa de cobertura ──────────────────────────────────
// Antes (2026-10-02): los combos usaban svc.features y svc.faqs con un
// replace de 'Las Condes', y NUNCA usaban el contenido unico de la
// comuna. Resultado: 98.2% de similitud entre dos combos del mismo
// servicio, patrón de doorway.
//
// Ahora: se conecta el contenido único que YA existía en content.ts
// (loc.intro, loc.features, loc.problems, loc.faqs) con la comuna. La
// funcion de la pagina deja de ser 'vender en una comuna' y pasa a ser
// 'documentar que operamos especificamente en esa comuna'.
const locIntro = loc.intro;
const locFeatures = loc.features;
const locProblems = loc.problems;
// La última FAQ de la comuna suele ser sobre cobertura o tiempo de
// respuesta, que es lo que un lead de esta comuna quiere confirmar.
const locFaq = loc.faqs[loc.faqs.length - 1];

// Block de cobertura: intersección entre lo que la comuna pide y lo que
// el servicio resuelve. Es el contenido que distingue una página de la
// misma página con otro nombre.
//
// NOTA DE IMPLEMENTACIÓN: se compara con includes y no con RegExp
// dinámica. Construir un RegExp desde una cadena con $ rompe esbuild
// (Expected colon but found ...), y ademas no aporta nada aqui. Gotcha
// registrado 2026-10-02.
const svcCorpus = svc.features
  .map((s) => s.title + ' ' + s.description)
  .join(' ')
  .toLowerCase();

const keywordsOf = (text: string) =>
  text
    .toLowerCase()
    .split(/[^a-záéíóúñü]+/)
    .filter((w) => w.length > 7);

const coveragePoints = locFeatures
  .filter((f) => {
    const kw = keywordsOf(f);
    // Exige 2 palabras en común: evita que una coincidencia aislada
    // produzca un match que no significa nada.
    return kw.filter((k) => svcCorpus.includes(k)).length >= 2;
  })
  .slice(0, 4);

// Si la intersección es vacía (combinación sin material compartido), se
// muestran los problemas de la comuna como contexto honesto: qué pasa en
// ese lugar y por qué el servicio existe. Sigue siendo contenido único.
const coverageFallback = locProblems.slice(0, 3);


const comboFeatures = svc.features.slice(0, 8).map(f => ({
  title: f.title,
  description: f.description,
}));

// Combo FAQs adaptadas al nombre de la comuna
const comboFaqs = svc.faqs.slice(0, 5).map(f => ({
  q: f.q.replace(/Las Condes|la comuna/g, loc.name),
  a: f.a.replace(/Las Condes|la comuna/g, loc.name),
}));

// Servicios relacionados (3 para 'Tambien te puede interesar')
const otrosServicios = Object.entries(SERVICE_NAMES)
  .filter(([s]) => s !== serviceSlug)
  .slice(0, 3)
  .map(([s, n]) => ({ slug: s, name: n }));

// Otras comunas donde se ofrece este servicio.
// Sin truncar: con `.slice(0, 8)` las 7 comunas finales (Vitacura, Conchalí,
// Pudahuel, Renca, La Pintana, Los Andes, San Felipe) nunca aparecían en el
// listado de ninguna página hermana, así que sus 42 páginas servicio×comuna
// quedaban con un solo enlace entrante —el de su página de comuna—. La lista
// completa además hace simétrico el vínculo entre hermanas.
const otrasUbicaciones = LOCATIONS.filter((l) => l.slug !== locationSlug);

// OS-10 / central de monitoreo / Guardpod solo aplican a servicios de
// vigilancia. Para aseo se emiten título, descripción y hero propios.
// Verificado 2026-10-02.
const certified = svc.certified !== false;
const seoTitle = certified
  ? `${svc.name} en ${loc.name} con Certificación OS-10`
  : `${svc.name} en ${loc.name}`;
const seoDescription = certified
  ? `${svc.name} en ${loc.name} con certificación OS-10. Personal propio, central de monitoreo 24/7 y unidades Guardpod disponibles para esta comuna de la zona ${loc.zone}. Cotización en 24 horas.`
  : `${svc.shortDesc} en ${loc.name}, zona ${loc.zone}. Personal uniformado con supervisor de terreno, productos certificados y reporte mensual. Cotización en 24 horas.`;
const heroLead = certified
  ? `GuardMan Chile ofrece ${svc.shortDesc.toLowerCase()} en ${loc.name} con monitoreo 24/7, guardias certificados OS-10 y el sistema autónomo Guardpod para faenas y perímetros sin infraestructura. Cobertura operativa en la zona ${loc.zone}.`
  : `GuardMan Chile ofrece ${svc.shortDesc.toLowerCase()} en ${loc.name}, con personal uniformado, productos certificados y supervisión de terreno. Cobertura operativa en la zona ${loc.zone}.`;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  breadcrumb={`${svc.name} en ${loc.name}`}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Servicios', url: '/servicios' },
    { name: svc.name, url: `/servicios/${serviceSlug}` },
    { name: loc.name, url: `/ubicaciones/${locationSlug}` },
    { name: `${svc.name} en ${loc.name}`, url: `/servicios/${serviceSlug}/${locationSlug}` },
  ]}
  service={{
    slug: serviceSlug,
    name: `${svc.name} en ${loc.name}`,
    description: `${svc.shortDesc} Cobertura operativa: ${loc.name}, zona ${loc.zone}.`,
    url: `/servicios/${serviceSlug}/${locationSlug}`,
    category: 'Seguridad Privada',
  }}
  location={locSchema}
  // La FAQ de la comuna se suma a las del servicio. Antes solo se usaban
// las del servicio con un replace de 'Las Condes'; la de la comuna nunca
  // se mostraba, y es la que responde la pregunta específica del lugar.
  faq={[
    ...comboFaqs.map(f => ({ question: f.q, answer: f.a })),
    ...(locFaq ? [{ question: locFaq.q, answer: locFaq.a }] : []),
  ]}
  showCluster={true}
  clusterType="servicio"
  clusterExclude={serviceSlug}
>
  <section class="detail-hero" data-od-id="hero">
    <div class="container hero-grid">
      <div>
        <div class="zone-badge">
          <span class={`zone-dot dot-${loc.zone.toLowerCase()}`}></span>
          <span>Zona {loc.zone}</span>
        </div>
        <h1>{svc.name} en {loc.name}</h1>
        <p>{heroLead}</p>
        <div class="detail-hero-ctas">
          <a href="/cotizacion" class="btn btn-primary">Cotizar ahora</a>
          <a href={`tel:${SITE.PHONE_TEL}`} class="btn btn-outline-light"><Icon name="phone" size={16} /> {SITE.PHONE}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="contenido" data-od-id="contenido">
    <div class="container">
      <div class="detail-content-grid">
        <div class="article-body">
          <div class="block" data-od-id="block-intro">
            <h2>{svc.name} en {loc.name}</h2>
            <p>{locIntro}</p>
            <p>{intro}</p>
            {certified && (
              <p>En {loc.name} el servicio se define a partir de una visita al sitio: accesos, infraestructura de videovigilancia existente, horarios de operación y el perfil de riesgo del propertiario. La dotación y los turnos se calculan con esa información, no con una estimación genérica.</p>
            )}
          </div>

          {/* Bloque de cobertura: contenido ÚNICO de esta comuna. Antes
              esta página repetía el copy del servicio con el nombre
              cambiado; ahora documenta qué operamos en este lugar. */}
          <div class="block coverage-block" data-od-id="block-coverage">
            <h2>Qué operamos en {loc.name}</h2>
            {coveragePoints.length > 0 ? (
              <>
                <p>
                  La operación de {svc.name.toLowerCase()} en {loc.name} se concentra en los
                  siguientes puntos, que son los que definen la cobertura en esta comuna:
                </p>
                <ul class="coverage-list">
                  {coveragePoints.map((p) => (
                    <li><Icon name="check" size={15} /> <span>{p}</span></li>
                  ))}
                </ul>
              </>
            ) : (
              <>
                <p>
                  En {loc.name} operamos en el marco general de {svc.name.toLowerCase()}, sin
                  una especialización distinta a la del resto de la zona. Lo que sí es
                  específico de esta comuna son las condiciones que enfrentamos en el sitio:
                </p>
                <ul class="coverage-list">
                  {coverageFallback.map((p) => (
                    <li><Icon name="warn" size={15} /> <span>{p}</span></li>
                  ))}
                </ul>
              </>
            )}
          </div>

          <div class="block" data-od-id="block-features">
            <h2>Por qué elegir {svc.name.toLowerCase()} en {loc.name}</h2>
            <div class="detail-features-grid">
              {comboFeatures.map((f) => (
                <div class="detail-feature-item">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                  <span><strong>{f.title} en {loc.name}:</strong> {f.description}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="block" data-od-id="block-issues">
            <h2>Problemas que resolvemos en {loc.name}</h2>
            <div class="detail-issues-grid">
              {svc.problems.slice(0, 6).map((p) => (
                <div class="detail-issue-card">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                  <span>{p}</span>
                </div>
              ))}
            </div>
          </div>

          <StaffSection />

          <div class="block" data-od-id="block-other-locations">
            <h2>También disponible en otras comunas</h2>
            <p>Seleccione su comuna para ver detalles y solicitar cotización.</p>
            <div class="locations-tags">
              <a href={`/servicios/${serviceSlug}/${locationSlug}`} class="loc-tag loc-tag-active">{loc.name}</a>
              {otrasUbicaciones.map((l) => (
                <a href={`/servicios/${serviceSlug}/${l.slug}`} class="loc-tag">{l.name}</a>
              ))}
            </div>
            <div style="margin-top:16px">
              <a href="/ubicaciones" class="btn btn-outline btn-sm">Explorar mapa de cobertura →</a>
            </div>
          </div>

          <div class="block" data-od-id="block-faq">
            <h2>Preguntas frecuentes</h2>
            <div class="detail-faq">
              {comboFaqs.map((f, i) => (
                <details open={i === 0}>
                  <summary>{f.q}</summary>
                  <div class="answer">{f.a}</div>
                </details>
              ))}
            </div>
          </div>

          <RelatedLinks
            items={bridgeItems(SERVICE_BRIDGE[serviceSlug])}
            title="Antes de contratar este servicio"
            subtitle="Lo que conviene revisar antes de decidir, independiente de quién lo ejecute."
            odId="block-bridge"
          />
        </div>

        <aside data-od-id="sidebar">
          <div class="sidebar-sticky">
            <div class="sidebar-cta-top">
              <h3>Cotice este servicio</h3>
              <a href="/cotizacion" class="btn btn-primary">Cotizar ahora</a>
              <a href="/contacto" class="btn btn-outline">Hablar con un experto</a>
            </div>
            <div class="sidebar-body">
              <div class="sb-section">
                <h4>Otros servicios en esta comuna</h4>
                {Object.entries(SERVICE_NAMES)
                  .filter(([s]) => s !== serviceSlug)
                  .slice(0, 4)
                  .map(([s, n]) => (
                    <a href={`/servicios/${s}/${locationSlug}`} class="sb-link">{n}</a>
                  ))}
              </div>
              <div class="sb-section">
                <h4>Sectores que atiende</h4>
                <div class="sb-tags">
                  {['comercial', 'residencial', 'industrial', 'construccion', 'eventos'].map((s) => (
                    <a href={`/sectores/${s}`} class="sb-tag">{s.charAt(0).toUpperCase() + s.slice(1)}</a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-neutral-section" data-od-id="block-related">
    <div class="container">
      <span class="section-label">Servicios relacionados</span>
      <h2 class="section-title">También le puede interesar</h2>
      <div class="related-grid-detail">
        {otrosServicios.map((r) => (
          <a href={`/servicios/${r.slug}`} class="related-card-block">
            <div class="related-icon" set:html={SERVICE_ICONS[r.slug] ?? ''} />
            <h3>{r.name}</h3>
            <p>Disponible también en {loc.name} con supervisión 24/7.</p>
            <span class="card-link">Ver más →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-dark cta-section-detail" data-od-id="block-cta">
    <div class="container" style="text-align:center">
      <h2 class="section-title" style="color:#fff">Cotice {svc.name.toLowerCase()} en {loc.name}</h2>
      <p class="section-subtitle" style="color:rgba(255,255,255,.7)">Evaluación gratuita sin compromiso. Cubrimos toda la comuna con respuesta coordinada.</p>
      <a href="/cotizacion" class="btn btn-primary btn-lg">Solicitar cotización</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Bloque de cobertura por comuna (Fase 2, 2026-10-02). */
  .coverage-block {
    border-left: 4px solid #3b82f6;
    padding-left: 20px;
    margin-top: 28px;
  }
  .coverage-block h2 { margin-bottom: 12px; }
  .coverage-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .coverage-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 8px 0;
    font-size: 15px;
    line-height: 1.65;
    color: #444;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }
  .coverage-list li:last-child { border-bottom: none; }
  .coverage-list svg { flex-shrink: 0; margin-top: 3px; color: #2563eb; }
</style>
