---
// /soluciones/[slug] — Soluciones integradas (Fase 4)
//
// El nicho aseo + seguridad. El argumento central NO es "hacemos más
// servicios": es que un solo proveedor resuelve la coordinación entre
// ambos, que es lo que ninguna empresa de seguridad ni de aseo puede
// resolver por separado.
//
// Estructura: la de /servicios/[slug]. Sin CSS propio.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SOLUTIONS } from '../../lib/soluciones';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { EDITORIAL_BRIDGE, bridgeItems } from '../../lib/internal-links';

export const prerender = true;

export function getStaticPaths() {
  return SOLUTIONS.map((s) => ({ params: { slug: s.slug }, props: { page: s } }));
}

const { page } = Astro.props;

const solutionLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.h1,
  description: page.metaDescription,
  serviceType: 'Seguridad privada y servicios de mantención',
  provider: { '@type': 'Organization', name: 'GuardMan Chile' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Región Metropolitana y Valparaíso' },
  audience: { '@type': 'Audience', audienceType: page.audienceLong },
  inLanguage: 'es-CL',
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  article={{
    headline: page.h1,
    description: page.metaDescription,
    datePublished: page.updatedISO,
    dateModified: page.updatedISO,
  }}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Soluciones', url: '/soluciones' },
    { name: page.title, url: `/soluciones/${page.slug}` },
  ]}
  faq={page.faqs.map((f) => ({ question: f.q, answer: f.a }))}
  extraSchemas={[solutionLd]}
>
  <section class="detail-hero" data-od-id="hero">
    <div class="container">
      <div class="detail-hero-badge">
        <span class="detail-hero-badge-icon">
          <Icon name="shield" size={14} />
        </span>
        {page.audience}
      </div>
      <h1>{page.h1}</h1>
      <p>{page.lead}</p>
      <div class="detail-hero-ctas">
        <a href="/cotizacion" class="btn btn-primary">Cotizar solución integrada</a>
        <a href="/soluciones" class="btn btn-outline-light">Ver todas las soluciones</a>
      </div>
    </div>
  </section>

  <section class="contenido" data-od-id="contenido">
    <div class="container">
      <div class="detail-content-grid">
        <div class="article-body">
          <div class="block" data-od-id="block-problema">
            <h2>El problema que ninguna empresa resuelve por separado</h2>
            <p>
              Contratar seguridad con una empresa y aseo con otra es lo habitual en el
              rubro. El problema es que nadie lidera la coordinación entre ambos servicios,
              y siempre hay una franja donde eso se nota.
            </p>
            <div class="detail-issues-grid">
              {page.coordinationProblem.map((p) => (
                <div class="detail-issue-card">
                  <Icon name="warn" size={18} />
                  <span>
                    <strong>{p.title}</strong> {p.body}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <div class="block" data-od-id="block-servicios">
            <h2>Qué incluye</h2>
            <div class="detail-features-grid">
              {page.services.map((s) => (
                <div class="detail-feature-item">
                  <Icon name="check" size={16} />
                  <span>
                    <strong>{s.name}</strong> ({s.role}) — {s.detail}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <RelatedLinks
            items={bridgeItems(EDITORIAL_BRIDGE[page.slug])}
            title="Los servicios que se integran"
            subtitle="Cada línea de esta solución se contrata por separado en el mercado. Aquí se operan bajo un mismo responsable."
            odId="block-bridge"
          />

          <div class="block" data-od-id="block-operacion">
            <h2>Cómo se opera</h2>
            <p>
              La diferencia entre dos proveedores y uno integrado no está en la lista de
              servicios, sino en cómo se coordina la operación diaria.
            </p>
            <div class="detail-features-grid">
              {page.operation.map((o, i) => (
                <div class="detail-feature-item">
                  <Icon name="check" size={16} />
                  <span>
                    <strong>{i + 1}. {o.step}</strong> {o.detail}
                  </span>
                </div>
              ))}
            </div>
          </div>

          {page.sections.map((s) => (
            <div class="block">
              <h2>{s.heading}</h2>
              {s.body.map((p) => <p>{p}</p>)}
            </div>
          ))}

          <div class="block" data-od-id="block-faq">
            <h2>Preguntas frecuentes</h2>
            <div class="detail-faq">
              {page.faqs.map((f, i) => (
                <details open={i === 0}>
                  <summary>{f.q}</summary>
                  <div class="answer">{f.a}</div>
                </details>
              ))}
            </div>
          </div>
        </div>

        <aside data-od-id="sidebar">
          <div class="sidebar-sticky">
            <div class="sidebar-cta-top">
              <h3>Cotiza el servicio integrado</h3>
              <p>
                Un solo interlocutor para seguridad y mantención, con alcance declarado y
                responsable único ante cualquier incidente.
              </p>
              <a href="/cotizacion" class="btn btn-primary">Cotizar ahora</a>
              <a href="/contacto" class="btn btn-outline">Hablar con un experto</a>
            </div>
            <div class="sidebar-body">
              <div class="sb-section">
                <h4>Otras soluciones</h4>
                {SOLUTIONS.filter((s) => s.slug !== page.slug).map((s) => (
                  <a href={`/soluciones/${s.slug}`} class="sb-link">{s.title}</a>
                ))}
              </div>
              <div class="sb-section">
                <h4>Guías de contratación</h4>
                <a href="/guias/como-elegir-empresa-de-seguridad" class="sb-link">Cómo verificar un proveedor</a>
                <a href="/guias/cuantos-guardias-necesita-mi-condominio" class="sb-link">Dotación de un condominio</a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <LeadCTA
    variant="inline"
    title="Cotiza el servicio integrado"
    subtitle="Un solo interlocutor para seguridad y mantención, con alcance declarado y responsable único ante cualquier incidente."
    trustBadges={true}
  />
</BaseLayout>
