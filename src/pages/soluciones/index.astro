---
// /soluciones — índice de soluciones integradas (seguridad + aseo).
//
// Patrón copiado de /servicios/ e /ubicaciones/:
//   hub-hero > bg-neutral (grid) > bg-white-section > bg-dark (CTA)
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SOLUTIONS } from '../../lib/soluciones';
import { SITE } from '../../lib/constants';
import Icon from '../../components/Icon.astro';

export const prerender = true;
---

<BaseLayout
  title="Soluciones integradas de seguridad y mantención"
  description="Seguridad y aseo con un solo responsable para condominios, edificios corporativos, centros comerciales, faenas y eventos."
  breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Soluciones', url: '/soluciones' }]}
>
  <section class="hub-hero" data-od-id="hero">
    <div class="container">
      <h1>Seguridad y mantención, con un solo responsable</h1>
      <p class="section-subtitle" style="color:rgba(255,255,255,.8);max-width:640px;margin:16px 0 0">
        Cada solución combina vigilancia y aseo con un mismo proveedor. El argumento no es la
        cantidad de servicios, sino la coordinación entre ambos.
      </p>
    </div>
  </section>

  <section class="bg-neutral" data-od-id="grid">
    <div class="container">
      <div class="card-grid">
        {SOLUTIONS.map((s) => (
          <a href={`/soluciones/${s.slug}`} class="card">
            <div class="card-body">
              <div class="card-icon">
                <Icon name="shield" size={20} />
              </div>
              <h3>{s.title}</h3>
              <p>{s.audienceLong}</p>
              <p>{s.metaDescription}</p>
              <span class="card-link">Ver solución →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white-section" data-od-id="argumento">
    <div class="container">
      <span class="section-label">Por qué un solo proveedor</span>
      <h2 class="section-title">La coordinación no la lidera nadie cuando son dos empresas</h2>
      <p class="section-subtitle" style="max-width:820px">
        El problema de coordinar una empresa de seguridad y otra de aseo no es teórico: son
        llaves entregadas informalmente, personal que entra a zonas comunes sin registro, y
        versiones distintas de un mismo hecho según a quién se le pregunte.
      </p>
      <p class="section-subtitle" style="max-width:820px">
        Cuando ambos servicios los presta una sola empresa, esa coordinación deja de ser un
        problema entre partes y pasa a ser parte de la operación diaria, con un solo
        responsable y un solo registro.
      </p>
      <div style="margin-top:28px">
        <a href="/soluciones/condominio-seguridad-y-aseo" class="btn btn-primary btn-lg">
          Ver el detalle de la solución para condominios
        </a>
      </div>
    </div>
  </section>

  <section class="bg-dark" data-od-id="cta">
    <div class="container" style="text-align:center;padding:80px 0">
      <h2 class="section-title" style="color:#fff">¿Necesita ambos servicios?</h2>
      <p class="section-subtitle" style="color:rgba(255,255,255,.7);max-width:600px;margin:0 auto 28px">
        Cotice el servicio integrado y reciba una propuesta con el alcance declarado: un solo
        interlocutor, un solo registro y un responsable único ante cualquier incidente.
      </p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
        <a href="/cotizacion" class="btn btn-primary btn-lg">Cotizar solución integrada</a>
        <a href={`tel:${SITE.PHONE_TEL}`} class="btn btn-outline-light btn-lg">
          <Icon name="phone" size={16} /> {SITE.PHONE}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
