---
// /guias — índice de guías de dotación y contratación.
//
// Usa PageHero y las clases canónicas de tarjeta (card-grid, card,
// card-icon, card-body, card-link) en vez de un CSS propio.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES } from '../../lib/guias';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';

export const prerender = true;
---

<BaseLayout
  title="Guías de seguridad privada"
  description="Guías prácticas sobre dotación de guardias, turnos, cobertura 24/7 y cómo elegir una empresa de seguridad privada en Chile."
  breadcrumb="Guías"
  breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Guías', url: '/guias' }]}
>
  <PageHero
    variant="dark"
    badge="Guías prácticas"
    badgeIcon="doc"
    title="Guías para contratar seguridad privada"
    subtitle="Explicamos cómo razonamos la dotación de un puesto de seguridad, qué preguntar antes de firmar y cómo comparar propuestas que parecen equivalentes y no lo son."
  />

  <section class="contenido" data-od-id="contenido">
    <div class="container">
      <div class="card-grid">
        {GUIDES.map((g) => (
          <a href={`/guias/${g.slug}`} class="card">
            <div class="card-body">
              <div class="card-icon">
                <Icon name="doc" size={20} />
              </div>
              <h3>{g.title}</h3>
              <p>{g.metaDescription}</p>
              <span class="card-link">Leer la guía →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section" data-od-id="nota">
    <div class="container">
      <div class="detail-issues-grid">
        <div class="detail-issue-card">
          <Icon name="warn" size={18} />
          <span>
            <strong>Por qué no publicamos ratios de dotación.</strong> Los números que
            circulan en internet sobre cuántos guardias necesita un condominio suelen
            provenir de otros países, con otras normas y otros niveles de riesgo. Explicamos
            el método completo —acceso, riesgo y horario— para que puedas evaluar cualquier
            propuesta, y dejamos los números a la vista del técnico en terreno.
          </span>
        </div>
      </div>
    </div>
  </section>

  <LeadCTA
    variant="inline"
    title="Solicita una evaluación"
    subtitle="La visita a terreno no tiene costo. Definimos la cobertura que corresponde a tu sitio en particular."
    trustBadges={true}
  />
</BaseLayout>
