---
// /guias/[slug] — Guías de dotación (Fase 3)
//
// Objetivo comercial: explicar el método con el que dimensionamos un
// puesto de seguridad para que un lead pueda evaluar la propuesta que
// reciba de cualquier proveedor. Restricción del CEO: se explica el
// marco (acceso - riesgo - horario) y no se publican ratios, fórmulas
// con coeficientes ni números resultantes. Ver cabecera de guias.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES, GUIDES_BY_SLUG } from '../../lib/guias';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';

export const prerender = true;

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { page: g } }));
}

const { page } = Astro.props;

const guideLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: page.h1,
  description: page.metaDescription,
  inLanguage: 'es-CL',
  step: page.assessment.map((a, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: a.step,
    text: a.detail,
  })),
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  article={{
    headline: page.h1,
    description: page.metaDescription,
    datePublished: page.updatedISO,
    dateModified: page.updatedISO,
  }}
  breadcrumb={page.title}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Guías', url: '/guias' },
    { name: page.title, url: `/guias/${page.slug}` },
  ]}
  faq={page.faqs.map((f) => ({ question: f.q, answer: f.a }))}
  extraSchemas={[guideLd]}
>
  <section class="guide-hero">
    <div class="container">
      <nav class="guide-crumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a> <span>/</span> <a href="/guias">Guías</a>
      </nav>
      <span class="guide-kicker">Guía práctica</span>
      <h1>{page.h1}</h1>
      <p class="guide-lead">{page.lead}</p>
    </div>
  </section>

  <section class="guide-body">
    <div class="container">
      <div class="guide-layout">
        <article class="guide-article">
          <section class="guide-section axes-section">
            <h2>Los tres factores que determinan la dotación</h2>
            <p>
              La dotación nunca sale de una regla general. Sale de evaluar tres variables juntas.
              Ninguna sirve por sí sola: un acceso controlado en un edificio de bajo riesgo no
              exige la misma cobertura que un acceso abierto en un sitio con historial de incidentes.
            </p>
            <div class="axes-grid">
              {page.axes.map((a) => (
                <div class="axis-card">
                  <span class="axis-name">{a.name}</span>
                  <h3>{a.question}</h3>
                  {a.body.map((p) => <p>{p}</p>)}
                </div>
              ))}
            </div>
          </section>

          <section class="guide-section">
            <h2>Cómo se hace la evaluación</h2>
            <p>
              El orden importa. No se puede cotizar antes de entender el sitio, y la primera
              evaluación es siempre presencial.
            </p>
            <ol class="steps-list">
              {page.assessment.map((a, i) => (
                <li>
                  <span class="step-num">{i + 1}</span>
                  <div>
                    <h3>{a.step}</h3>
                    <p>{a.detail}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <section class="guide-section">
            <h2>Errores frecuentes al contratar</h2>
            <p>
              Estos son los errores que más se repiten, y todos son evitables si se hacen las
              preguntas correctas antes de firmar.
            </p>
            <div class="mistakes-list">
              {page.mistakes.map((m) => (
                <div class="mistake">
                  <Icon name="warn" size={18} />
                  <div>
                    <h3>{m.mistake}</h3>
                    <p>{m.consequence}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

          {page.sections.map((s) => (
            <section class="guide-section">
              <h2>{s.heading}</h2>
              {s.body.map((p) => <p>{p}</p>)}
            </section>
          ))}

          <section class="guide-section guide-faq">
            <h2>Preguntas frecuentes</h2>
            {page.faqs.map((f) => (
              <details open={f === page.faqs[0]}>
                <summary>{f.q}</summary>
                <div class="answer">{f.a}</div>
              </details>
            ))}
          </section>
        </article>

        <aside class="guide-aside">
          <div class="guide-aside-card cta-card">
            <h3>{page.ctaTitle}</h3>
            <p>{page.ctaBody}</p>
            <a href="/cotizacion" class="btn btn-primary btn-block">Solicitar cotización</a>
          </div>

          <div class="guide-aside-card">
            <h3>Otras guías</h3>
            <ul class="guide-aside-list">
              {GUIDES.filter((g) => g.slug !== page.slug).map((g) => (
                <li><a href={`/guias/${g.slug}`}>{g.title}</a></li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="guide-cta-section">
    <div class="container">
      <LeadCTA
        title="GuardMan Chile"
        description="200+ guardias certificados OS-10, central de monitoreo propia 24/7 y cobertura en 16 comunas."
      />
    </div>
  </section>
</BaseLayout>

<style is:global>
  .guide-hero {
    background: var(--navy, #1a2744);
    padding: 56px 0 48px;
    color: #fff;
  }
  .guide-crumb { font-size: 13px; color: rgba(255, 255, 255, 0.6); margin-bottom: 20px; }
  .guide-crumb a { color: rgba(255, 255, 255, 0.85); text-decoration: none; }
  .guide-crumb a:hover { color: #fff; text-decoration: underline; }
  .guide-crumb span { margin: 0 6px; opacity: 0.4; }
  .guide-kicker {
    display: inline-block; font-size: 12px; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7); margin-bottom: 14px;
  }
  .guide-hero h1 {
    font-size: clamp(28px, 4.2vw, 42px); font-weight: 800; line-height: 1.15;
    margin: 0 0 18px; max-width: 780px; letter-spacing: -0.02em;
  }
  .guide-lead {
    font-size: clamp(16px, 1.7vw, 18px); line-height: 1.65;
    color: rgba(255, 255, 255, 0.85); max-width: 720px; margin: 0;
  }
  .guide-body { padding: 48px 0 64px; }
  .guide-layout {
    display: grid; grid-template-columns: minmax(0, 1fr) 300px;
    gap: 48px; align-items: start;
  }
  @media (max-width: 1024px) { .guide-layout { grid-template-columns: 1fr; gap: 40px; } }
  .guide-section { margin-bottom: 40px; }
  .guide-section h2 {
    font-size: 24px; font-weight: 700; margin: 0 0 16px;
    line-height: 1.3; color: var(--navy, #1a2744);
  }
  .guide-section p { font-size: 16px; line-height: 1.75; color: #333; margin: 0 0 16px; }
  .guide-cta-section { padding: 0 0 64px; }

  .axes-grid { display: grid; gap: 20px; margin-top: 24px; }
  .axis-card {
    border: 1px solid #e2e6ec; border-left: 4px solid #3b82f6;
    border-radius: 10px; padding: 22px 24px; background: #fff;
  }
  .axis-name {
    display: inline-block; font-size: 12px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: #2563eb; margin-bottom: 8px;
  }
  .axis-card h3 { font-size: 18px; font-weight: 700; margin: 0 0 12px; color: var(--navy, #1a2744); line-height: 1.4; }
  .axis-card p { font-size: 15px; line-height: 1.7; color: #444; margin: 0 0 12px; }
  .axis-card p:last-child { margin-bottom: 0; }

  .steps-list { list-style: none; counter-reset: step; padding: 0; margin: 24px 0 0; }
  .steps-list li { display: flex; gap: 16px; margin-bottom: 20px; align-items: flex-start; }
  .step-num {
    flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%;
    background: var(--navy, #1a2744); color: #fff; font-weight: 700;
    display: flex; align-items: center; justify-content: center; font-size: 15px;
  }
  .steps-list h3 { font-size: 16px; font-weight: 700; margin: 4px 0 6px; color: var(--navy, #1a2744); }
  .steps-list p { font-size: 15px; line-height: 1.7; color: #555; margin: 0; }

  .mistakes-list { margin-top: 24px; }
  .mistake {
    display: flex; gap: 14px; align-items: flex-start;
    border: 1px solid #f1d4d4; border-radius: 10px;
    padding: 18px 20px; margin-bottom: 14px; background: #fefafa;
  }
  .mistake :global(svg) { color: #dc2626; flex-shrink: 0; margin-top: 3px; }
  .mistake h3 { font-size: 16px; font-weight: 700; margin: 0 0 6px; color: #991b1b; }
  .mistake p { font-size: 15px; line-height: 1.7; color: #555; margin: 0; }

  .guide-faq details {
    border: 1px solid #e2e6ec; border-radius: 8px; padding: 16px 18px;
    margin-bottom: 10px; background: #fff;
  }
  .guide-faq summary {
    font-weight: 600; cursor: pointer; font-size: 16px;
    color: var(--navy, #1a2744); list-style: none;
  }
  .guide-faq summary::-webkit-details-marker { display: none; }
  .guide-faq summary::before { content: '+'; margin-right: 10px; color: #3b82f6; font-weight: 700; }
  .guide-faq details[open] summary::before { content: '−'; }
  .guide-faq .answer { margin-top: 12px; font-size: 15px; line-height: 1.7; color: #444; }

  .guide-aside { position: sticky; top: 24px; }
  @media (max-width: 1024px) { .guide-aside { position: static; } }
  .guide-aside-card {
    border: 1px solid #e2e6ec; border-radius: 12px;
    padding: 24px; margin-bottom: 20px; background: #fff;
  }
  .cta-card { border-color: #3b82f6; background: #f8fbff; }
  .guide-aside-card h3 { font-size: 16px; font-weight: 700; margin: 0 0 10px; color: var(--navy, #1a2744); }
  .guide-aside-card p { font-size: 14px; line-height: 1.65; color: #555; margin: 0 0 16px; }
  .guide-aside-list { list-style: none; margin: 0; padding: 0; }
  .guide-aside-list li { margin-bottom: 12px; }
  .guide-aside-list a { font-size: 14px; color: #333; text-decoration: none; line-height: 1.5; display: block; }
  .guide-aside-list a:hover { color: #2563eb; }
</style>
