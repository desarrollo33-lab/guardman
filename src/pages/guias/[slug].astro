---
// /guias/[slug] — Guías de dotación y contratación (Fase 3)
//
// Estructura: replica la de /servicios/[slug], que es la página de detalle
// canónica del sitio. No hay CSS propio: todo sale de classes que ya existen
// en components.css (detail-*, article-body, block, faq-*, legal-table) y de
// los widgets PageHero, LeadCTA y RelatedLinks.
//
// Reemplaza a una versión anterior que traía ~200 líneas de CSS duplicado
// con variables hardcodeadas (#1A2744 en vez de var(--primary)), clases
// inventadas (guide-hero, axis-card, steps-list) y un aside propio. El
// resultado era visualmente ajeno al resto del sitio.
//
// Restricción del CEO: se explica el método (acceso, riesgo, horario) y no
// se publican ratios, fórmulas ni números resultantes. Ver cabecera de
// guias.ts.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES } from '../../lib/guias';
import Icon from '../../components/Icon.astro';
import LeadCTA from '../../components/LeadCTA.astro';
import FaqList from '../../components/FaqList.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { EDITORIAL_BRIDGE, bridgeItems } from '../../lib/internal-links';

export const prerender = true;

export function getStaticPaths() {
  return GUIDES.map((g) => ({ params: { slug: g.slug }, props: { page: g } }));
}

const { page } = Astro.props;

// HowTo schema: los pasos de la guía son el procedimiento que se declara.
const guideLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: page.h1,
  description: page.metaDescription,
  inLanguage: 'es-CL',
  step: page.assessment.map((a, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: a.step,
    text: a.detail,
  })),
};
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  article={{
    headline: page.h1,
    description: page.metaDescription,
    datePublished: page.updatedISO,
    dateModified: page.updatedISO,
  }}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Guías', url: '/guias' },
    { name: page.title, url: `/guias/${page.slug}` },
  ]}
  faq={page.faqs.map((f) => ({ question: f.q, answer: f.a }))}
  extraSchemas={[guideLd]}
>
  <section class="detail-hero" data-od-id="hero">
    <div class="container">
      <div class="detail-hero-badge">
        <span class="detail-hero-badge-icon">
          <Icon name="doc" size={14} />
        </span>
        Guía práctica
      </div>
      <h1>{page.h1}</h1>
      <p>{page.lead}</p>
      <div class="detail-hero-ctas">
        <a href="/cotizacion" class="btn btn-primary">Solicitar evaluación</a>
        <a href="/guias" class="btn btn-outline-light">Ver todas las guías</a>
      </div>
    </div>
  </section>

  <section class="contenido" data-od-id="contenido">
    <div class="container">
      <div class="detail-content-grid">
        <div class="article-body">
          <div class="block" data-od-id="block-axes">
            <h2>Los tres factores que determinan la dotación</h2>
            <p>
              La dotación nunca sale de una regla general. Sale de evaluar tres variables
              juntas. Ninguna sirve por sí sola: un acceso bien controlado en un edificio
              de bajo riesgo no exige la misma cobertura que un acceso abierto en un
              sitio con historial de incidentes.
            </p>
            <div class="detail-features-grid">
              {page.axes.map((a) => (
                <div class="detail-feature-item">
                  <Icon name="check" size={16} />
                  <span>
                    <strong>{a.name}:</strong> {a.question} {a.body.join(' ')}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <div class="block" data-od-id="block-assessment">
            <h2>Cómo se hace la evaluación</h2>
            <p>
              El orden importa. No se puede cotizar antes de entender el sitio, y la
              primera evaluación es siempre presencial.
            </p>
            <div class="detail-features-grid">
              {page.assessment.map((a, i) => (
                <div class="detail-feature-item">
                  <Icon name="check" size={16} />
                  <span>
                    <strong>{i + 1}. {a.step}:</strong> {a.detail}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <div class="block" data-od-id="block-mistakes">
            <h2>Errores frecuentes al contratar</h2>
            <p>
              Estos son los errores que más se repiten, y todos son evitables si se
              hacen las preguntas correctas antes de firmar.
            </p>
            <div class="detail-issues-grid">
              {page.mistakes.map((m) => (
                <div class="detail-issue-card">
                  <Icon name="warn" size={18} />
                  <span>
                    <strong>{m.mistake}</strong> {m.consequence}
                  </span>
                </div>
              ))}
            </div>
          </div>

          {page.sections.map((s) => (
            <div class="block">
              <h2>{s.heading}</h2>
              {s.body?.map((p) => <p>{p}</p>)}
              {s.list && <FaqList items={s.list} odId={`block-${s.heading.slice(0, 20).replace(/\s+/g, '-').toLowerCase()}`} />}
            </div>
          ))}

          <div class="block" data-od-id="block-faq">
            <h2>Preguntas frecuentes</h2>
            <div class="detail-faq">
              {page.faqs.map((f, i) => (
                <details open={i === 0}>
                  <summary>{f.q}</summary>
                  <div class="answer">{f.a}</div>
                </details>
              ))}
            </div>
          </div>

          <RelatedLinks
            items={bridgeItems(EDITORIAL_BRIDGE[page.slug])}
            title="Los servicios detrás de esta guía"
            subtitle="Una vez definida la dotación o el proceso, estos son los servicios concretos que lo ejecutan."
            odId="block-bridge"
          />
        </div>

        <aside data-od-id="sidebar">
          <div class="sidebar-sticky">
            <div class="sidebar-cta-top">
              <h3>{page.ctaTitle}</h3>
              <p>{page.ctaBody}</p>
              <a href="/cotizacion" class="btn btn-primary">Cotizar para mi propiedad</a>
              <a href="/contacto" class="btn btn-outline">Enviar mi consulta</a>
            </div>
            <div class="sidebar-body">
              <div class="sb-section">
                <h4>Otras guías</h4>
                {GUIDES.filter((g) => g.slug !== page.slug).map((g) => (
                  <a href={`/guias/${g.slug}`} class="sb-link">{g.title}</a>
                ))}
              </div>
              <div class="sb-section">
                <h4>Marco legal</h4>
                <a href="/seguridad-privada" class="sb-link">Guías de referencia</a>
                <a href="/guias/como-elegir-empresa-de-seguridad" class="sb-link">Cómo verificar un proveedor</a>
                <a href="/seguridad-privada/que-es-os-10" class="sb-link">Qué es la certificación OS-10</a>
              </div>
              <div class="sb-section">
                <h4>Soluciones</h4>
                <div class="sb-tags">
                  <a href="/soluciones/condominio-seguridad-y-aseo" class="sb-tag sb-tag-residencial">Condominios</a>
                  <a href="/soluciones/edificio-corporativo-cctv-y-aseo" class="sb-tag sb-tag-comercial">Oficinas</a>
                  <a href="/soluciones/centro-comercial-guardias-y-limpieza" class="sb-tag sb-tag-comercial">Centros comerciales</a>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <LeadCTA
    variant="inline"
    title="GuardMan Chile"
    subtitle="200+ guardias certificados OS-10, central de monitoreo propia 24/7 y cobertura en 16 comunas."
    trustBadges={true}
  />
</BaseLayout>
