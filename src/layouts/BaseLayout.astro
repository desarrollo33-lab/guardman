---
// BaseLayout — Layout raíz del sitio público v5.2
// SEO+GEO ready: schemas Service/ServiceArea/Place/Review, geo meta,
// hreflang, OG article, theme-color, sitemap enrichment.
// v5.2: título sin separadores `|` o `-`; español neutro; design tokens unificados.
import '../styles/global.css';
import '../styles/design-tokens.css';
import '../styles/components.css';
import '../styles/thanks.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../lib/constants';
import {
  organizationSchema,
  localBusinessSchema,
  serviceSchema,
  locationSchema,
  breadcrumbSchema,
  faqSchema,
  articleSchema,
  speakableSchema,
  websiteSchema,
  geoMetaTags,
  hreflangTags,
  type BreadcrumbItem,
} from '../lib/seo';
import { INTER_FONT_URL, type Location } from '../lib/constants';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  /** 'light' (sitio público) | 'dark' (Guard Pod / Ajax). Por defecto light. */
  theme?: 'light' | 'dark';
  /** Cargar dark.css (override para páginas dark). */
  loadDarkCss?: boolean;
  /** Etiqueta de breadcrumb (ej. "Servicios", "Las Condes"). */
  breadcrumb?: string;
  /** Schema LocalBusiness (homepage). */
  localBusiness?: boolean;
  /** Schema Product/Servicio (páginas de servicio). */
  product?: {
    name: string;
    description: string;
    image?: string;
    url?: string;
  };
  /** Schema Service (servicios). */
  service?: {
    slug: string;
    name: string;
    description: string;
    url: string;
    image?: string;
    category?: string;
  };
  /** Schema ServiceArea + Place (páginas de ubicación). */
  location?: Location;
  /** Schema FAQPage (páginas con preguntas frecuentes). */
  faq?: { question: string; answer: string }[];
  /** Schema Article (contenido editorial). */
  article?: {
    headline: string;
    description: string;
    image?: string;
    datePublished?: string;
    dateModified?: string;
    author?: string;
  };
  /** Items para BreadcrumbList schema. */
  breadcrumbs?: BreadcrumbItem[];
  /** Mostrar cluster de links relacionados al final. */
  showCluster?: boolean;
  /** Cluster tipo: servicios | ubicaciones | sectores | servicio | ubicacion | sector. */
  clusterType?: 'servicios' | 'ubicaciones' | 'sectores' | 'servicio' | 'ubicacion' | 'sector';
  /** Slug del item actual (para excluirlo del cluster). */
  clusterExclude?: string;
}

const {
  title,
  description = SITE.DESCRIPTION,
  canonical,
  ogImage = '/images/og-default-v2.jpg',
  noindex = false,
  theme = 'light',
  loadDarkCss = false,
  breadcrumb,
  localBusiness = false,
  product,
  service,
  location,
  faq,
  article,
  breadcrumbs,
  showCluster = false,
  clusterType,
  clusterExclude,
} = Astro.props;

const url = canonical ?? new URL(Astro.url.pathname, SITE.URL).href;
// v5.2: títulos sin separadores `|` o `-`. Se concatena con espacio natural.
// Cada page ya entrega su title en español neutro sin guiones ni pipes.
const fullTitle = title.includes(SITE.NAME) ? title : `${title} ${SITE.NAME}`;
const ogType = article ? 'article' : 'website';
const publishedISO = article?.datePublished ?? '2024-01-01';
const modifiedISO = article?.dateModified ?? new Date().toISOString().slice(0, 10);

// ── Critical CSS (above-the-fold, ~1.5 KB minified) ───────────────
// Aplicado inline antes del primer paint. Sin roundtrip de red para
// body, container, header, hero, btn. El resto del CSS (cards, footer,
// forms, etc.) llega async con `media="print" onload="this.media='all'"`.
const CRITICAL_CSS = `body{font-family:'Inter','Inter Fallback',system-ui,-apple-system,sans-serif;color:#0D0D0D;background:#F8F9FA;line-height:1.5;-webkit-font-smoothing:antialiased}
.container{max-width:1280px;margin:0 auto;padding:0 16px}
header.site-header{position:sticky;top:0;z-index:1100;background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.05)}
.header-inner{display:flex;align-items:center;justify-content:space-between;height:64px;max-width:1280px;margin:0 auto;padding:0 16px}
@media(min-width:1024px){.header-inner{height:80px}}
.logo{display:flex;align-items:center;gap:8px;flex-shrink:0}
.logo-img{height:38px;width:auto;display:block}
@media(min-width:1024px){.logo-img{height:42px}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:10px 20px;font-size:15px;font-weight:600;border-radius:8px;transition:transform .2s,box-shadow .2s,border-color .2s,background-color .2s,color .2s;border:2px solid transparent;cursor:pointer;font-family:inherit;white-space:nowrap}
.btn-primary{background:#1A2744;color:#fff}.btn-primary:hover{background:#0F1829}
.btn-outline-light{background:transparent;color:#fff;border-color:rgba(255,255,255,.25)}.btn-outline-light:hover{background:rgba(255,255,255,.08)}
.btn-lg{padding:14px 28px;font-size:16px}
.hero{background:#1A2744;padding:64px 0;position:relative;overflow:hidden}
@media(min-width:1024px){.hero{padding:80px 0}}
.hero::before{content:'';position:absolute;top:-180px;right:-60px;width:600px;height:600px;background:radial-gradient(circle,rgba(59,130,246,.12),transparent 70%);border-radius:50%;z-index:1;will-change:transform}
.hero-bg{position:absolute;inset:0;z-index:0}
.hero .container{position:relative;z-index:2}
.hero h1{font-size:clamp(32px,5vw,52px);font-weight:800;color:#fff;line-height:1.1;margin-bottom:18px;max-width:680px;letter-spacing:-.025em}
.hero p{font-size:clamp(15px,1.6vw,17px);color:rgba(255,255,255,.85);line-height:1.6;margin-bottom:24px;max-width:560px}
.hero-ctas{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:32px}
.hero-stats{display:flex;gap:48px;flex-wrap:wrap;padding-top:24px;margin-top:8px;border-top:1px solid rgba(255,255,255,.12)}
.hero-stat-value{font-size:32px;font-weight:800;color:#fff;line-height:1.1;letter-spacing:-.02em}
.hero-stat-label{font-size:13px;font-weight:500;color:rgba(255,255,255,.7);margin-top:6px;line-height:1.3;max-width:160px}`;

// ── Schemas ─────────────────────────────────────────────────────
const orgLd = organizationSchema();
const websiteLd = websiteSchema();
const localBusinessLd = localBusiness ? localBusinessSchema() : null;
const serviceLd = service ? serviceSchema(service) : null;
const productLd = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      description: product.description,
      image: product.image ? new URL(product.image, SITE.URL).href : `${SITE.URL}/favicon.svg`,
      url: product.url ?? url,
      brand: { '@type': 'Brand', name: SITE.NAME },
      provider: { '@type': 'Organization', name: SITE.NAME, url: SITE.URL },
      category: 'Seguridad Privada',
    }
  : null;
const locationLd = location ? locationSchema({ location }) : null;
const articleLd = article
  ? articleSchema({ ...article, url: Astro.url.pathname })
  : null;
const faqLd = faq && faq.length > 0 ? faqSchema(faq) : null;
const breadcrumbLd =
  (breadcrumbs && breadcrumbs.length > 0) || breadcrumb
    ? breadcrumbSchema(
        breadcrumbs && breadcrumbs.length > 0
          ? breadcrumbs
          : [{ name: breadcrumb!, url: Astro.url.pathname }],
      )
    : null;
const speakableLd = speakableSchema(Astro.url.pathname);

// Todos los JSON-LD en un array para imprimir
const allSchemas = [
  orgLd, websiteLd, localBusinessLd, serviceLd, productLd,
  ...(locationLd ?? []), articleLd, faqLd, breadcrumbLd, speakableLd,
].filter(Boolean);

const geoTags = geoMetaTags();
const hreflangs = hreflangTags(Astro.url.pathname);
---

<!doctype html>
<html lang="es-CL">
  <head>
    {/* Forzar scroll a top en cada navegación/recarga (preserva links con #hash). */}
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      addEventListener('pageshow', function () {
        if (!location.hash) scrollTo(0, 0);
      });
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.LEGAL_NAME} />
    <meta name="language" content="Spanish" />
    <meta name="revisit-after" content="7 days" />
    <meta name="rating" content="general" />
    <meta name="distribution" content="global" />
    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />

    {/* Canonical */}
    <link rel="canonical" href={url} />

    {/* Hreflang multi-región */}
    {hreflangs.map((h) => (
      <link rel="alternate" hreflang={h.hreflang} href={h.href} />
    ))}

    {/* Geo + misc meta tags */}
    {geoTags.map((t) => (
      <meta name={t.name} content={t.content} />
    ))}

    {/* OpenGraph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(ogImage, SITE.URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:locale:alternate" content="es_419" />
    <meta property="og:site_name" content={SITE.NAME} />
    {article && (
      <>
        <meta property="article:published_time" content={publishedISO} />
        <meta property="article:modified_time" content={modifiedISO} />
        <meta property="article:author" content={article.author ?? SITE.LEGAL_NAME} />
        <meta property="article:section" content="Seguridad Privada" />
        <meta property="article:publisher" content={SITE.URL} />
      </>
    )}

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.URL).href} />
    <meta name="twitter:image:alt" content={fullTitle} />
    <meta name="twitter:label1" content="Escrito por" />
    <meta name="twitter:data1" content={SITE.LEGAL_NAME} />
    <meta name="twitter:label2" content="Tiempo de lectura" />
    <meta name="twitter:data2" content="3 min" />

    {/* Icons */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="mask-icon" href="/favicon.svg" color="#1A2744" />

    {/* Critical CSS inline (above-the-fold: body, container, header, hero, btn).
        Aplicado antes del primer paint sin roundtrip de red.
        FCP y LCP bajan ~0.5-1.0s en lab run. */}
    <style is:inline set:html={CRITICAL_CSS} />

    {/* Preload Inter Variable para que el browser levante el woff2 en paralelo
        al primer paint y no haya FOUT visible en el hero. crossorigin es obligatorio
        aunque same-origin porque el browser exige credenciales para una fuente.
        IMPORTANTE: la URL debe matchar exactamente la del @font-face en
        public/styles/site.css (mismo ?v=FONT_VERSION). Si difiere, el browser
        hace doble GET y los 344 KB se duplican a 689 KB. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={INTER_FONT_URL}
      crossorigin="anonymous"
    />

    {/* CSS principal: async, NO bloquea el primer paint.
        El id específico evita el bug del querySelector sobre <noscript><link>.
        Cuando el CSS async aplica, los estilos heredan del critical — sin CLS. */}
    <link
      rel="stylesheet"
      id="site-css-main"
      href="/styles/site.css?v=20260825"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="/styles/site.css?v=20260825" />
    </noscript>
    {loadDarkCss && (
      <link
        rel="stylesheet"
        id="dark-css-main"
        href="/styles/dark.css?v=20260825"
        media="print"
        onload="this.media='all'"
      />
    )}

    {/* JSON-LD structured data — todos los schemas */}
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <link rel="llms-txt" href="/llms.txt" type="text/markdown" />

    <slot name="head" />
  </head>
  <body data-theme={theme} class:list={[theme === 'dark' && 'dark-page']}>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <Header theme={theme} />

    {breadcrumb && (
      <nav class="breadcrumb" data-od-id="breadcrumb" aria-label="Breadcrumb">
        <div class="breadcrumb-inner">
          <a href="/">Inicio</a>
          <span class="breadcrumb-sep">/</span>
          <span aria-current="page">{breadcrumb}</span>
        </div>
      </nav>
    )}

    <main id="main-content">
      <slot />
      {showCluster && clusterType && (
        <RelatedLinks type={clusterType} exclude={clusterExclude} />
      )}
    </main>

    <Footer />
    <Analytics />
    <script is:inline src="/scripts/main.js"></script>
    <script is:inline src="/scripts/yt-lite.js"></script>
  </body>
</html>
