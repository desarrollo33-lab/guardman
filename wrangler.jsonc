{
  // Cloudflare Workers config for guardman-astro (Astro 6 SSR).
  // PUBLIC_* vars are exposed to the client bundle and are intentionally
  // public (domain + API origin). Any real secret (API keys, signing
  // secrets) belongs in the Cloudflare Secrets Store — set with:
  //   npx wrangler secret put <NAME>
  // and read in handlers via env.<NAME>.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guardman-astro",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // El sitio se publica SOLO en guardman.cl (y su alias www, que 301 al apex).
  // Sin esto, cada `wrangler deploy` vuelve a publicar el worker en
  // `*.oficinadesarrollo33.workers.dev`: una copia indexable del sitio, con el
  // nombre de la cuenta que lo hostea en la URL, que el 2026-10-03 apareció en
  // búsquedas. El 301 de `src/lib/canonical-host.ts` es la red de seguridad
  // para cuando este host se republique; el flag es lo que lo evita.
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "head_sampling_rate": 1
  },
  "vars": {
    // Login / refresh / logout viven en este mismo worker (consolidación
    // 2026-09-22 — antes apuntaban a `guardman.oficinadesarrollo33.workers.dev`
    // que está muerto). Same-origin resuelve CORS y CSP de un plumazo.
    "PUBLIC_API_URL": "",
    "PUBLIC_SITE_URL": "https://guardman.cl"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "guardman-v2-db",
      "database_id": "fd1871a2-77a4-42ca-8b07-de283ff70bab",
      "migrations_dir": "migrations"
    }
  ]
}
